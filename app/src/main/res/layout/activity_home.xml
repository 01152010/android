<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/themeColor">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/home_padding_tb"
        android:paddingStart="@dimen/home_padding_lr"
        android:paddingEnd="@dimen/home_padding_lr">
        <RelativeLayout
            android:id="@+id/rl_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_padding_tb">

            <ImageView
                android:id="@+id/iv_xiezhukeji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@mipmap/xiezhukeji"></ImageView>
            <TextClock
                android:id="@+id/hour_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="5dp"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/white"
                android:textSize="@dimen/home_time_size" />
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/frame_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll_bottom"
            android:layout_below="@+id/rl_top">
            <include
                android:id="@+id/rl_home"
                android:visibility="visible"
                layout="@layout/layout_home"/>
            <include
                android:id="@+id/ll_dk"
                android:visibility="gone"
                layout="@layout/layout_dk"/>
            <include
                android:id="@+id/ll_kt"
                android:visibility="gone"
                layout="@layout/layout_kt"/>
            <include
                android:id="@+id/ll_cl"
                android:visibility="gone"
                layout="@layout/layout_cl"/>
            <include
                android:id="@+id/ll_tv"
                android:visibility="gone"
                layout="@layout/layout_tv"/>
            <include
                android:id="@+id/ll_ms"
                android:visibility="gone"
                layout="@layout/layout_ms"/>
            <include
                android:id="@+id/ll_service"
                android:visibility="gone"
                layout="@layout/layout_service"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_padding_tb"
            android:layout_marginBottom="3dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/ll_tab1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab1">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="首页"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tab2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab2">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="灯光"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tab3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab3">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="空调"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tab4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab4">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="窗帘"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tab5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab5">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="电视"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tab6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab6">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="门锁"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tab7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sel_bg_home_tab7">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_item_top"
                    android:text="服务"
                    android:textColor="@drawable/sel_text"
                    android:textSize="@dimen/tab_text_size">
                </TextView>
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
    <com.upad.view.ScreenView
        android:id="@+id/screenview"
        android:layout_width="wrap_content"
        android:layout_alignParentRight="true"
        android:visibility="gone"
        android:layout_height="wrap_content">
    </com.upad.view.ScreenView>
    <com.upad.view.VoiceView
        android:id="@+id/voiceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
    </com.upad.view.VoiceView>
</RelativeLayout>