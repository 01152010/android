<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/home_padding_tb"
    android:layout_marginBottom="@dimen/home_padding_tb"
    android:paddingTop="@dimen/padding_tb"
    android:paddingBottom="@dimen/padding_tb"
    android:paddingStart="@dimen/home_padding_lr"
    android:paddingEnd="@dimen/home_padding_lr"
    android:background="@color/cardColor">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tablelayout_kt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:tabBackground="@color/cardColor"
        app:tabTextColor="@drawable/sel_text"
        app:tabIndicatorColor="@color/textColorSel"
        app:tabTextAppearance="@style/TabLayoutTextSize"
        app:tabIndicatorFullWidth="false">
    </com.google.android.material.tabs.TabLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/home_padding_lr"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1.2"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:text="26"
                    android:textSize="@dimen/kt_temp_size"
                    android:textColor="@color/white">
                </TextView>
                <TextView
                    android:id="@+id/tv_temp_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u2103"
                    android:textSize="@dimen/text_size"
                    android:textColor="@color/white">
                </TextView>
            </LinearLayout>
            <com.upad.view.TempView
                android:id="@+id/tempview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            </com.upad.view.TempView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:gravity="top">
                <LinearLayout
                    android:id="@+id/ll_onff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/text_padding_tb"
                    android:paddingBottom="@dimen/text_padding_tb"
                    android:layout_marginEnd="@dimen/home_margin_right"
                    android:orientation="horizontal"
                    android:background="@color/white_3"
                    android:clickable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/iv_kt_onff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/press_kt_of"
                        android:layout_marginEnd="@dimen/icon_margin_right">
                    </ImageView>
                    <TextView
                        android:id="@+id/tv_kt_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                    <TextView
                        android:id="@+id/tv_kt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                    <TextView
                        android:id="@+id/tv_kt_off"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_wind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/text_padding_tb"
                    android:paddingBottom="@dimen/text_padding_tb"
                    android:layout_marginStart="@dimen/home_margin_right"
                    android:orientation="horizontal"
                    android:background="@color/white_3"
                    android:clickable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/iv_kt_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/press_kt_wind"
                        android:layout_marginEnd="@dimen/icon_margin_right">
                    </ImageView>
                    <TextView
                        android:id="@+id/tv_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="低速"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:gravity="center">
                <LinearLayout
                    android:id="@+id/ll_hot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/text_padding_tb"
                    android:paddingBottom="@dimen/text_padding_tb"
                    android:layout_marginEnd="@dimen/home_margin_right"
                    android:orientation="horizontal"
                    android:background="@color/white_3"
                    android:clickable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/iv_kt_hot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/press_kt_hot"
                        android:layout_marginEnd="@dimen/icon_margin_right">
                    </ImageView>
                    <TextView
                        android:id="@+id/tv_kt_hot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="制热"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_cold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/text_padding_tb"
                    android:paddingBottom="@dimen/text_padding_tb"
                    android:layout_marginStart="@dimen/home_margin_right"
                    android:orientation="horizontal"
                    android:background="@color/white_3"
                    android:clickable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/iv_kt_cold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/press_kt_cold"
                        android:layout_marginEnd="@dimen/icon_margin_right">
                    </ImageView>
                    <TextView
                        android:id="@+id/tv_kt_cold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="制冷"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal">
                <LinearLayout
                    android:id="@+id/ll_arefaction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/text_padding_tb"
                    android:paddingBottom="@dimen/text_padding_tb"
                    android:layout_marginEnd="@dimen/home_margin_right"
                    android:orientation="horizontal"
                    android:background="@color/white_3"
                    android:clickable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/iv_kt_are"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/press_kt_arefaction"
                        android:layout_marginEnd="@dimen/icon_margin_right">
                    </ImageView>
                    <TextView
                        android:id="@+id/tv_kt_are"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="除湿"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_swind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/text_padding_tb"
                    android:paddingBottom="@dimen/text_padding_tb"
                    android:layout_marginStart="@dimen/home_margin_right"
                    android:orientation="horizontal"
                    android:background="@color/white_3"
                    android:clickable="true"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/iv_kt_swind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/press_kt_swind"
                        android:layout_marginEnd="@dimen/icon_margin_right">
                    </ImageView>
                    <TextView
                        android:id="@+id/tv_kt_swind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="送风"
                        android:textSize="@dimen/text_size"
                        android:textColor="@drawable/sel_text">
                    </TextView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>